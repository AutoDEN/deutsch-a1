 "lines": [
  {"voice": "erzaehler", "text": "Lange und kurze Vokale."},
  {"voice": "erzaehler", "text": "studieren, hier, Bier."},
  {"voice": "erzaehler", "text": "Fisch, Milch, Zimmer."},
  {"voice": "erzaehler", "text": "Tüte, früh, gemütlich."},
  {"voice": "erzaehler", "text": "wünschen, Stück, Müll."},
  {"voice": "erzaehler", "text": "gehen, See, Tee."},
  {"voice": "erzaehler", "text": "spät, Käse, Nähe."},
  {"voice": "erzaehler", "text": "Bett, Fest, Geschenk."},
  {"voice": "erzaehler", "text": "schön, hören, Größe."},
  {"voice": "erzaehler", "text": "können, öffentlich, köstlich."},
  {"voice": "erzaehler", "text": "Tag, Abend, Bad."},
  {"voice": "erzaehler", "text": "Nacht, machen, kalt."},
  {"voice": "erzaehler", "text": "gut, Stuhl, Blume."},
  {"voice": "erzaehler", "text": "Lust, Bus, Kunde."},
  {"voice": "erzaehler", "text": "wohnen, rot, Brot."},
  {"voice": "erzaehler", "text": "Morgen, kommen, Topf."},
  {"voice": "erzaehler", "text": "danke, Tasche, bitte."},
  {"voice": "erzaehler", "text": "Rentner, immer, lecker."},
  {"voice": "erzaehler", "text": "hier, Bier, Nachbar."},
  {"voice": "erzaehler", "text": "Diphthonge."},
  {"voice": "erzaehler", "text": "Arbeit, heißen, Wein."},
  {"voice": "erzaehler", "text": "Frau, auch, Baum."},
  {"voice": "erzaehler", "text": "heute, Leute, neu."},
  {"voice": "erzaehler", "text": "Konsonanten."},
  {"voice": "erzaehler", "text": "Milch, Küche, eigentlich."},
  {"voice": "erzaehler", "text": "Nacht, machen, Buch."},
  {"voice": "erzaehler", "text": "schön, spät, Stuhl."},
  {"voice": "erzaehler", "text": "Morgen, rot, Rose."},
  {"voice": "erzaehler", "text": "wohnen, Wein, wünschen."},
  {"voice": "erzaehler", "text": "Foto, Fisch, voll."},
  {"voice": "erzaehler", "text": "sein, Sonne, See."},
  {"voice": "erzaehler", "text": "heißen, Glas, Spaß."},
  {"voice": "erzaehler", "text": "Zufall, Zeitung, zahlen."},
  {"voice": "erzaehler", "text": "Kopf, Apfel, Pflanze."},
  {"voice": "erzaehler", "text": "tschüss, deutsch."},
  {"voice": "erzaehler", "text": "danke, Lesung, singen."},
  {"voice": "erzaehler", "text": "haben, heute, Hilfe."},
  {"voice": "erzaehler", "text": "Jahr, jetzt, Jahreszeit."},
  {"voice": "erzaehler", "text": "Wochenende, Abendessen, überall."},
  {"voice": "erzaehler", "text": "Silbische Konsonanten."},
  {"voice": "erzaehler", "text": "Morgen, machen, Abend."},
  {"voice": "erzaehler", "text": "Apfel, Himmel, Enkelkind."},
  {"voice": "erzaehler", "text": "Minimalpaare."},
  {"voice": "erzaehler", "text": "Staat — Stadt. Beet — Bett. Miete — Mitte. Ofen — offen."}
 ]
